---
import { BlogPost } from '@partials/BlogPost';
import { CTA } from '@partials/CTA';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import type { IFrontmatter } from 'astro-boilerplate-components';

interface BlogPostFrontmatter extends IFrontmatter {
  url: string;
}
export interface Props {
  content: BlogPostFrontmatter;
}

const { content } = Astro.props as Props;
const title = `${content.title} - ${AppConfig.site_name}`;
const ogImage = `https://graphigen.vercel.app/api/og?author=Akhil%20G%20Krishnan&title=${encodeURIComponent(
  content.title
)}&description=${encodeURIComponent(
  content.description
)}&image=${encodeURIComponent('https://blog.saeloun.com/images/og_logo.png')}&date=${encodeURIComponent(
  content.pubDate
)}&type=blog.png`;

const postPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const postUrl = `${AppConfig.site_url}${postPath}`;
const breadcrumbs = [
  { name: 'Home', url: AppConfig.site_url },
  { name: 'Blogs', url: `${AppConfig.site_url}/blogs/` },
  { name: content.title, url: postUrl },
];

const articleSchema = {
  title: content.title,
  description: content.description,
  url: postUrl,
  imageUrl: ogImage,
  datePublished: content.pubDate,
};

const articleMeta = {
  publishedTime: content.pubDate,
  author: 'Akhil G Krishnan',
  section: 'Technology',
};
---

<Base
  head={{ title, description: content.description, ogImage, ogType: 'article', url: postUrl, noindex: true, breadcrumbs, articleMeta, articleSchema }}
>
  <BlogPost frontmatter={content}>
    <p>{content.description}</p>
    <p>
      <a href={content.url} target="_blank" rel="noopener">Read the full article on the Saeloun blog &rarr;</a>
    </p>
    <slot />
  </BlogPost>

  <CTA />
</Base>
